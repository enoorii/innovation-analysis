# Backend origin used by the Vite dev proxy (/api → backend, path stripped).
# The FastAPI dev task runs on 9123 (backend/pyproject.toml → poe dev).
VITE_API_BASE_URL=http://127.0.0.1:9123

# In production builds (no Vite proxy) the chat client falls back to this
# value, or http://127.0.0.1:9123 if unset. Remember to add your deployed
# frontend origin to DASHBOARD_ORIGIN in backend/.env for CORS.